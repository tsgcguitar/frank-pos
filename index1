function donut(id,rows){
  if(!rows.length){setHTML(id,'<div class="empty">無資料</div>');return}
  const colors=['#2f6feb','#22a06b','#7556e8','#f59e0b','#d65353','#56b4e9'];
  const total=sum(rows.map(x=>x.value))||1; let pos=0, parts=[];
  rows.forEach((x,i)=>{let a=pos/total*360;pos+=x.value;let b=pos/total*360;parts.push(`${colors[i%colors.length]} ${a}deg ${b}deg`)});
  setHTML(id,`<div class="donutwrap"><div class="donut" style="background:conic-gradient(${parts.join(',')})"></div><div class="legend">${rows.map((x,i)=>`<div><span class="dot" style="background:${colors[i%colors.length]}"></span>${x.label} <b>${(x.value/total*100).toFixed(1)}%</b></div>`).join('')}</div></div>`);
}
function lineChart(id,rows){
  if(!rows.length){setHTML(id,'<div class="empty">無資料</div>');return}
  const w=900,h=250,p=32,max=Math.max(...rows.map(x=>x.value),1),min=0;
  const pts=rows.map((x,i)=>{let X=p+(w-2*p)*(rows.length===1?0:i/(rows.length-1)),Y=h-p-(h-2*p)*(x.value-min)/(max-min||1);return [X,Y]});
  const path=pts.map((p,i)=>(i?'L':'M')+p[0].toFixed(1)+','+p[1].toFixed(1)).join(' ');
  const area=path+` L ${pts[pts.length-1][0]},${h-p} L ${pts[0][0]},${h-p} Z`;
  const grids=[0,.25,.5,.75,1].map(t=>{let y=h-p-(h-2*p)*t;return `<line class="gridline" x1="${p}" y1="${y}" x2="${w-p}" y2="${y}"/><text class="axislabel" x="2" y="${y+3}">${money(max*t)}</text>`}).join('');
  const labels=rows.map((x,i)=>i%Math.ceil(rows.length/8)===0?`<text class="axislabel" x="${pts[i][0]-12}" y="${h-5}">${x.label}</text>`:'').join('');
  setHTML(id,`<svg class="linechart" viewBox="0 0 ${w} ${h}" preserveAspectRatio="none">${grids}<path class="trendfill" d="${area}"/><path class="trendline" d="${path}"/>${labels}</svg>`);
}
function filters(){
  return {from:$('from').value,to:$('to').value,store:$('storef').value,type:$('typef').value,member:$('memberf').value}
}
function filtered(){
  const f=filters();
  const os=O.filter(o=>!(o.Business_Date<f.from||o.Business_Date>f.to) && (f.store==='ALL'||o.Store_Name===f.store) && (f.type==='ALL'||o.Order_Type===f.type) && (f.member==='ALL'||(f.member==='M'?isMem(o):!isMem(o))));
  const ids=new Set(os.map(o=>o.Transaction_ID));
  return {os,is:I.filter(i=>ids.has(i.Transaction_ID))}
}
function storeMetrics(os){
  return Object.entries(group(done(os),o=>o.Store_Name)).map(([s,r])=>{
    let dine=r.filter(o=>o.Order_Type==='內用'),days=Math.max(uniq(r.map(o=>o.Business_Date)).length,1),rev=sum(r.map(o=>o.Final_Total)),g=sum(r.map(o=>o.Guest_Count));
    return {s,rev,g,avgSpend:g?rev/g:0,dine:dine.length,turn:dine.length/(CAP[s]||1)/days,dining:avg(dine.map(o=>Number(o.Dining_Minutes||0)))}
  }).sort((a,b)=>b.rev-a.rev)
}
function render(){
  const {os,is}=filtered(), c=done(os), ci=done(is), dine=c.filter(o=>o.Order_Type==='內用');
  let rev=sum(c.map(o=>o.Final_Total)),g=sum(c.map(o=>o.Guest_Count));
  let sm=storeMetrics(os), turn=avg(sm.map(x=>x.turn)), din=avg(dine.map(o=>Number(o.Dining_Minutes||0)));
  $('rev').textContent=money(rev);$('guests').textContent=num(g);$('avgspend').textContent=money(g?rev/g:0);$('turn').textContent=turn.toFixed(2)+' 次';$('dining').textContent=Math.round(din)+' min';

  let bd=group(c,o=>o.Business_Date), dates=Object.keys(bd).sort();
  lineChart('trend',dates.map(d=>({label:d.slice(5),value:sum(bd[d].map(x=>x.Final_Total))})));

  let bh=group(c,hour), hrs=Object.keys(bh).sort(), hourRows=hrs.map(h=>({label:h,value:sum(bh[h].map(x=>x.Final_Total))})).sort((a,b)=>b.value-a.value).slice(0,10);
  barList('hourbar',hourRows.map((x,i)=>({...x,display:money(x.value),warn:i===0})));

  let bc=group(c,o=>o.Order_Channel||'其他'), cr=Object.entries(bc).map(([k,v])=>({label:k,value:v.length})).sort((a,b)=>b.value-a.value); donut('channel',cr);
  let bp=group(c,o=>o.Payment_Method||'其他'), pr=Object.entries(bp).map(([k,v])=>({label:k,value:v.length})).sort((a,b)=>b.value-a.value); barList('payment',pr);

  let longest=[...sm].sort((a,b)=>b.dining-a.dining)[0], peak=hourRows[0], memRev=sum(c.filter(isMem).map(o=>o.Final_Total));
  setHTML('overviewInsights',`
    <div class="insight"><b>尖峰營收：${peak?.label||'—'}</b><span>該時段營收 ${money(peak?.value||0)}</span></div>
    <div class="insight"><b>${longest?.s||'—'} 用餐時間最長</b><span>平均 ${Math.round(longest?.dining||0)} 分鐘</span></div>
    <div class="insight"><b>會員營收占比 ${rev?(memRev/rev*100).toFixed(1):0}%</b><span>可繼續分析會員回購與客單</span></div>`);

  barList('storeRev',sm.map(x=>({label:x.s,value:x.rev,display:money(x.rev)})));
  let maxD=Math.max(...sm.map(x=>x.dining),0);barList('storeDining',sm.map(x=>({label:x.s,value:x.dining,display:Math.round(x.dining)+' min',bad:x.dining===maxD})));
  setHTML('storeRows',sm.map(x=>`<tr><td><b>${x.s}</b></td><td>${money(x.rev)}</td><td>${num(x.g)}</td><td>${money(x.avgSpend)}</td><td>${num(x.dine)}</td><td>${x.turn.toFixed(2)} 次</td><td class="${x.dining===maxD?'badtext':''}">${Math.round(x.dining)} min</td></tr>`).join(''));

  let mem=c.filter(isMem), non=c.filter(o=>!isMem(o)), memR=sum(mem.map(o=>o.Final_Total)), nonR=sum(non.map(o=>o.Final_Total)); donut('memberDonut',[{label:'會員',value:memR},{label:'非會員',value:nonR}]);
  let lv=group(c,o=>o.Member_Level||'非會員'), lvr=Object.entries(lv).map(([k,v])=>({label:k,value:sum(v.map(x=>x.Final_Total)),display:money(sum(v.map(x=>x.Final_Total)))})).sort((a,b)=>b.value-a.value);barList('levelBars',lvr);
  let mg=sum(mem.map(o=>o.Guest_Count)),ng=sum(non.map(o=>o.Guest_Count));
  setHTML('memberStats',`<div class="stat"><span>會員訂單占比</span><b>${c.length?(mem.length/c.length*100).toFixed(1):0}%</b></div><div class="stat"><span>會員客單</span><b>${money(mg?memR/mg:0)}</b></div><div class="stat"><span>非會員客單</span><b>${money(ng?nonR/ng:0)}</b></div><div class="stat"><span>活躍會員</span><b>${uniq(mem.map(o=>o.Member_ID)).length}</b></div>`);
  let bm=group(mem,o=>o.Member_ID), mr=Object.entries(bm).map(([id,r])=>({name:r[0].Member_Name||id,level:r[0].Member_Level||'一般',cnt:r.length,total:sum(r.map(x=>x.Final_Total))})).sort((a,b)=>b.total-a.total).slice(0,10);
  setHTML('memberRows',mr.map(x=>`<tr><td><b>${x.name}</b></td><td>${x.level}</td><td>${x.cnt}</td><td>${money(x.total)}</td><td>${money(x.total/x.cnt)}</td></tr>`).join('')||'<tr><td colspan="5">無會員資料</td></tr>');

  let bi=group(ci,i=>i.Item_Name), ir=Object.entries(bi).map(([k,r])=>({label:k,value:sum(r.map(x=>x.Line_Total)),disc:sum(r.map(x=>x.Allocated_Discount||0))})).sort((a,b)=>b.value-a.value);
  barList('itemBars',ir.slice(0,10).map(x=>({...x,display:money(x.value)})));
  let cats=group(ci,i=>i.Category), catr=Object.entries(cats).map(([k,r])=>({label:k,value:sum(r.map(x=>x.Line_Total)),display:money(sum(r.map(x=>x.Line_Total)))})).sort((a,b)=>b.value-a.value);barList('catBars',catr);
  let tx=group(ci,i=>i.Transaction_ID), pc={};Object.values(tx).forEach(r=>{let ns=uniq(r.map(x=>x.Item_Name)).sort();for(let a=0;a<ns.length;a++)for(let b=a+1;b<ns.length;b++){let k=ns[a]+'|||'+ns[b];pc[k]=(pc[k]||0)+1}});
  let pairs=Object.entries(pc).sort((a,b)=>b[1]-a[1]).slice(0,8);setHTML('pairs',pairs.map(([k,v])=>{let [a,b]=k.split('|||');return `<div class="pair"><b>${a} + ${b}</b><span>同張訂單出現 ${v} 次</span></div>`}).join('')||'<div class="empty">無足夠資料</div>');
  let dr=ir.filter(x=>x.disc>0).sort((a,b)=>b.disc-a.disc).slice(0,10);setHTML('discRows',dr.map(x=>`<tr><td>${x.label}</td><td>${money(x.disc)}</td><td>${money(x.value)}</td><td>${(x.disc/(x.disc+x.value)*100).toFixed(1)}%</td></tr>`).join('')||'<tr><td colspan="4">無折扣資料</td></tr>');

  let hd=group(dine,hour), hdr=Object.keys(hd).sort().map(h=>({label:h,value:avg(hd[h].map(x=>Number(x.Dining_Minutes||0))),display:Math.round(avg(hd[h].map(x=>Number(x.Dining_Minutes||0))))+' min'}));let maxHD=Math.max(...hdr.map(x=>x.value),0);barList('hourDining',hdr.map(x=>({...x,bad:x.value===maxHD})));
  let bst=group(c,o=>o.Store_Name), sdr=Object.entries(bst).map(([s,r])=>{let gross=sum(r.map(x=>x.Subtotal)),disc=sum(r.map(x=>x.Discount_Amount));return {label:s,value:gross?disc/gross*100:0}});let maxSD=Math.max(...sdr.map(x=>x.value),0);barList('storeDisc',sdr.map(x=>({...x,display:x.value.toFixed(1)+'%',warn:x.value===maxSD})));

  let others=sm.filter(x=>x.s!==longest?.s), otherAvg=avg(others.map(x=>x.dining)), worstHour=[...hdr].sort((a,b)=>b.value-a.value)[0], highDisc=[...sdr].sort((a,b)=>b.value-a.value)[0];
  $('problemTitle').textContent=longest?`${longest.s} 平均用餐時間偏長`:'目前資料不足';
  $('problemText').textContent=longest?`平均 ${Math.round(longest.dining)} 分鐘，其他門市平均約 ${Math.round(otherAvg)} 分鐘。停留時間過長可能壓低尖峰時段翻桌與接客能力。`:'請調整篩選條件';
  setHTML('causes',`<div class="flow">用餐時間最高時段：${worstHour?.label||'—'}</div><div class="flow">檢查點餐 → 出餐時間</div><div class="flow">檢查外送與內用是否同時集中</div><div class="flow">檢查桌邊服務 / 結帳等待</div><div class="flow">${highDisc?.label||'—'} 折扣率也值得追蹤</div>`);
  setHTML('actions',`<div class="flow">依每小時訂單量調整排班</div><div class="flow">尖峰前完成備料</div><div class="flow">內用與外送出餐分流</div><div class="flow">優化結帳與支付流程</div><div class="flow">改善後重看 Dining Time / Turnover / Revenue</div>`);
}
function init(){
  $('orderCount').textContent=O.length.toLocaleString();$('itemCount').textContent=I.length.toLocaleString();
  uniq(O.map(o=>o.Store_Name)).sort().forEach(s=>$('storef').insertAdjacentHTML('beforeend',`<option>${s}</option>`));
  ['from','to','storef','typef','memberf'].forEach(id=>$(id).addEventListener('change',render));
  $('reset').onclick=()=>{$('from').value='2026-08-01';$('to').value='2026-08-31';$('storef').value='ALL';$('typef').value='ALL';$('memberf').value='ALL';render()};
  document.querySelectorAll('.navbtn').forEach(b=>b.onclick=()=>{document.querySelectorAll('.navbtn').forEach(x=>x.classList.remove('active'));document.querySelectorAll('.view').forEach(x=>x.classList.remove('active'));b.classList.add('active');$(b.dataset.view).classList.add('active')});
  render();
}
init();
</script>
</body>
</html>
