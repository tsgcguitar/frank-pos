<!doctype html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Restaurant POS Operations Analytics</title>
<style>
:root{--bg:#f4f7fb;--panel:#fff;--ink:#14243a;--muted:#718399;--line:#e3eaf2;--blue:#2f6feb;--green:#23956b;--orange:#e49a19;--red:#d65353;--purple:#7556e8;--navy:#102844}
*{box-sizing:border-box}body{margin:0;font-family:Arial,"Microsoft JhengHei",sans-serif;background:var(--bg);color:var(--ink)}
.shell{display:flex;min-height:100vh}.side{width:240px;background:linear-gradient(180deg,#102844,#0b1e34);color:#fff;padding:26px 18px;position:fixed;inset:0 auto 0 0}
.brand{display:flex;gap:12px;align-items:center;margin-bottom:28px}.logo{width:46px;height:46px;border-radius:13px;background:#4380e6;display:grid;place-items:center;font-weight:900}.brand b{display:block}.brand small{color:#aac0d6}
.nav button{width:100%;border:0;background:transparent;color:#b9c8d7;padding:12px 13px;border-radius:10px;text-align:left;font-weight:700;cursor:pointer;margin:3px 0}.nav button.active,.nav button:hover{background:#ffffff18;color:#fff}
.sidebox{margin-top:28px;padding:14px;border:1px solid #ffffff18;background:#ffffff0d;border-radius:13px}.sidebox small{color:#91a8bf}.sidebox strong{display:block;font-size:22px;margin:7px 0 2px}
.main{margin-left:240px;width:calc(100% - 240px);padding:28px 32px 50px}.top{display:flex;justify-content:space-between;gap:20px;align-items:flex-start}.eyebrow{font-size:11px;letter-spacing:.12em;font-weight:900;color:#68819d;text-transform:uppercase}.top h1{font-size:29px;margin:5px 0}.top p{color:var(--muted);margin:0}.badge{background:#e9f8f1;color:#1b7653;border:1px solid #ccebdc;border-radius:999px;padding:9px 12px;font-size:12px;font-weight:800}
.filters{display:grid;grid-template-columns:repeat(5,1fr) auto;gap:10px;background:#fff;padding:14px;border:1px solid var(--line);border-radius:15px;margin:20px 0;box-shadow:0 8px 25px #213d6510}.f label{display:block;color:#7a8b9f;font-size:10px;font-weight:800;margin:0 0 5px 2px}.f select,.f input{width:100%;border:1px solid #d9e2ec;background:#fbfcfe;padding:10px;border-radius:9px;color:var(--ink)}.reset{border:0;background:#edf2f7;border-radius:9px;padding:10px 14px;align-self:end;font-weight:800;cursor:pointer}
.view{display:none}.view.active{display:block}.kpis{display:grid;grid-template-columns:repeat(5,1fr);gap:13px}.kpi,.panel{background:#fff;border:1px solid var(--line);border-radius:15px;box-shadow:0 8px 25px #213d6510}.kpi{padding:17px;border-top:3px solid var(--blue)}.kpi:nth-child(2){border-top-color:var(--green)}.kpi:nth-child(3){border-top-color:var(--purple)}.kpi:nth-child(4){border-top-color:var(--orange)}.kpi:nth-child(5){border-top-color:var(--red)}.kpi small{color:#73859a;font-weight:800}.kpi strong{display:block;font-size:27px;margin-top:9px}.kpi span{font-size:11px;color:#8c9baa}
.grid2{display:grid;grid-template-columns:1.4fr 1fr;gap:13px;margin-top:13px}.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:13px;margin-top:13px}.panel{padding:17px;min-width:0}.panel h2{font-size:16px;margin:4px 0 15px}.chart{height:280px;position:relative;overflow:hidden}.chart.small{height:235px}.empty{height:100%;display:grid;place-items:center;color:#94a3b4}
.sectionhead{display:flex;justify-content:space-between;align-items:end;margin:4px 0 13px}.sectionhead h2{font-size:24px;margin:4px 0}.sectionhead p{color:var(--muted);font-size:13px;margin:0}
.barlist{display:grid;gap:9px}.barrow{display:grid;grid-template-columns:120px 1fr 75px;gap:9px;align-items:center;font-size:12px}.track{height:12px;background:#edf2f7;border-radius:999px;overflow:hidden}.fill{height:100%;background:var(--blue);border-radius:999px}.fill.warn{background:var(--orange)}.fill.bad{background:var(--red)}.barrow b{text-align:right}
.donutwrap{display:grid;grid-template-columns:160px 1fr;gap:18px;align-items:center}.donut{width:150px;height:150px;border-radius:50%;position:relative}.donut:after{content:"";position:absolute;inset:28px;background:#fff;border-radius:50%}.legend{display:grid;gap:8px}.legend div{font-size:12px}.dot{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:7px}
.linechart{width:100%;height:100%}.axislabel{fill:#8393a4;font-size:10px}.gridline{stroke:#e8edf3;stroke-width:1}.trendline{fill:none;stroke:#2f6feb;stroke-width:3}.trendfill{fill:#2f6feb12}
table{width:100%;border-collapse:collapse;min-width:720px}th{background:#f7f9fc;color:#728399;text-align:left;font-size:11px;padding:10px;border-bottom:1px solid var(--line)}td{font-size:12px;padding:11px 10px;border-bottom:1px solid #edf1f5}.tablewrap{overflow:auto}.badtext{color:var(--red);font-weight:800}.goodtext{color:var(--green);font-weight:800}
.insights,.pairs,.stats{display:grid;gap:9px}.insight,.pair,.stat{background:#f7f9fc;border:1px solid #edf1f5;border-radius:11px;padding:11px}.insight b,.pair b{display:block;font-size:13px}.insight span,.pair span{font-size:11px;color:#74869a}.stat{display:flex;justify-content:space-between;align-items:center}.stat span{color:#73859a;font-size:12px}.stat b{font-size:18px}
.diaggrid{display:grid;grid-template-columns:repeat(3,1fr);gap:13px;margin-top:13px}.diag{background:#fff;border:1px solid var(--line);border-radius:15px;padding:18px;box-shadow:0 8px 25px #213d6510}.diag.problem{border-top:4px solid var(--red)}.diag.action{border-top:4px solid var(--green)}.diag h3{margin:6px 0 9px;font-size:17px}.diag p{font-size:12px;color:#65798e;line-height:1.6}.flow{background:#f6f8fb;padding:9px 10px;border-radius:9px;font-size:12px;margin-top:7px}.action .flow{background:#edf8f2;color:#2f6d53}
.story{display:flex;justify-content:space-around;align-items:center;margin-top:13px}.step{text-align:center}.step b{display:block}.step small{display:block;color:#7f90a2;margin-top:4px}.circle{width:28px;height:28px;border-radius:50%;background:#eaf1ff;color:#3568bb;display:inline-grid;place-items:center;font-weight:900;margin-bottom:6px}.arrow{font-size:24px;color:#9bacc0}
.note{font-size:11px;color:#8192a4;margin-top:18px}
@media(max-width:1100px){.kpis{grid-template-columns:repeat(3,1fr)}.filters{grid-template-columns:repeat(3,1fr)}.grid3{grid-template-columns:1fr 1fr}.diaggrid{grid-template-columns:1fr}}
@media(max-width:760px){.side{position:static;width:100%}.shell{display:block}.main{margin-left:0;width:100%;padding:18px}.nav{display:flex;overflow:auto}.nav button{width:auto;white-space:nowrap}.sidebox{display:none}.top{flex-direction:column}.filters,.kpis,.grid2,.grid3{grid-template-columns:1fr}.story{display:grid;gap:10px}.arrow{transform:rotate(90deg)}}
</style>
</head>
<body>
<div class="shell">
<aside class="side">
  <div class="brand"><div class="logo">POS</div><div><b>Restaurant Analytics</b><small>Operations Intelligence</small></div></div>
  <div class="nav">
    <button class="navbtn active" data-view="overview">▣ Overview</button>
    <button class="navbtn" data-view="store">⌂ Store</button>
    <button class="navbtn" data-view="customer">◎ Customer</button>
    <button class="navbtn" data-view="product">◇ Product</button>
    <button class="navbtn" data-view="operations">↗ Operations</button>
  </div>
  <div class="sidebox"><small>SYNTHETIC DATASET</small><strong id="orderCount">—</strong><small>POS Orders</small><strong id="itemCount">—</strong><small>Item Lines</small></div>
</aside>
<main class="main">
  <div class="top"><div><div class="eyebrow">BUSINESS INTELLIGENCE PROJECT</div><h1>Restaurant POS Operations Analytics</h1><p>POS Transaction → KPI → Insight → Action</p></div><div class="badge">● Standalone Demo</div></div>
  <div class="filters">
    <div class="f"><label>開始日期</label><input id="from" type="date" value="2026-08-01"></div>
    <div class="f"><label>結束日期</label><input id="to" type="date" value="2026-08-31"></div>
    <div class="f"><label>門市</label><select id="storef"><option value="ALL">全部門市</option></select></div>
    <div class="f"><label>訂單類型</label><select id="typef"><option value="ALL">全部</option><option>內用</option><option>外帶</option><option>外送</option></select></div>
    <div class="f"><label>會員狀態</label><select id="memberf"><option value="ALL">全部</option><option value="M">會員</option><option value="N">非會員</option></select></div>
    <button class="reset" id="reset">重設</button>
  </div>

  <section class="view active" id="overview">
    <div class="kpis">
      <div class="kpi"><small>NET REVENUE</small><strong id="rev">—</strong><span>完成訂單淨營收</span></div>
      <div class="kpi"><small>CUSTOMERS</small><strong id="guests">—</strong><span>來客人次</span></div>
      <div class="kpi"><small>AVG SPEND / GUEST</small><strong id="avgspend">—</strong><span>客單價</span></div>
      <div class="kpi"><small>TABLE TURNOVER</small><strong id="turn">—</strong><span>平均每日翻桌</span></div>
      <div class="kpi"><small>AVG DINING TIME</small><strong id="dining">—</strong><span>內用平均停留</span></div>
    </div>
    <div class="grid2">
      <div class="panel"><div class="eyebrow">TREND</div><h2>每日營業額</h2><div id="trend" class="chart"></div></div>
      <div class="panel"><div class="eyebrow">PEAK HOUR</div><h2>各時段營業額</h2><div id="hourbar" class="chart barlist"></div></div>
    </div>
    <div class="grid3">
      <div class="panel"><div class="eyebrow">CHANNEL</div><h2>訂單來源</h2><div id="channel" class="chart small"></div></div>
      <div class="panel"><div class="eyebrow">PAYMENT</div><h2>付款方式</h2><div id="payment" class="chart small barlist"></div></div>
      <div class="panel"><div class="eyebrow">INSIGHT</div><h2>本期重點</h2><div id="overviewInsights" class="insights"></div></div>
    </div>
  </section>

  <section class="view" id="store">
    <div class="sectionhead"><div><div class="eyebrow">STORE PERFORMANCE</div><h2>門市營運比較</h2></div><p>營收、客單、翻桌、用餐時間</p></div>
    <div class="grid2"><div class="panel"><h2>門市營收</h2><div id="storeRev" class="chart barlist"></div></div><div class="panel"><h2>平均用餐時間</h2><div id="storeDining" class="chart barlist"></div></div></div>
    <div class="panel" style="margin-top:13px"><h2>門市 KPI 明細</h2><div class="tablewrap"><table><thead><tr><th>門市</th><th>營收</th><th>來客</th><th>客單</th><th>內用桌次</th><th>平均每日翻桌</th><th>平均用餐</th></tr></thead><tbody id="storeRows"></tbody></table></div></div>
  </section>

  <section class="view" id="customer">
    <div class="sectionhead"><div><div class="eyebrow">CUSTOMER INTELLIGENCE</div><h2>會員與顧客分析</h2></div><p>會員貢獻與高價值顧客</p></div>
    <div class="grid3"><div class="panel"><h2>會員 / 非會員營收</h2><div id="memberDonut" class="chart small"></div></div><div class="panel"><h2>會員等級</h2><div id="levelBars" class="chart small barlist"></div></div><div class="panel"><h2>會員 KPI</h2><div id="memberStats" class="stats"></div></div></div>
    <div class="panel" style="margin-top:13px"><h2>Top 10 高價值會員</h2><div class="tablewrap"><table><thead><tr><th>會員</th><th>等級</th><th>消費次數</th><th>累計消費</th><th>平均每筆</th></tr></thead><tbody id="memberRows"></tbody></table></div></div>
  </section>

  <section class="view" id="product">
    <div class="sectionhead"><div><div class="eyebrow">PRODUCT PERFORMANCE</div><h2>商品與購物籃分析</h2></div><p>熱門商品、品類與商品搭配</p></div>
    <div class="grid2"><div class="panel"><h2>Top 10 商品營收</h2><div id="itemBars" class="chart barlist"></div></div><div class="panel"><h2>品類營收</h2><div id="catBars" class="chart barlist"></div></div></div>
    <div class="grid2"><div class="panel"><h2>常見商品組合</h2><div id="pairs" class="pairs"></div></div><div class="panel"><h2>商品折扣排行</h2><div class="tablewrap"><table><thead><tr><th>商品</th><th>折扣</th><th>營收</th><th>折扣率</th></tr></thead><tbody id="discRows"></tbody></table></div></div></div>
  </section>

  <section class="view" id="operations">
    <div class="sectionhead"><div><div class="eyebrow">FROM KPI TO ACTION</div><h2>營運問題診斷</h2></div><p>從異常到改善方案</p></div>
    <div class="grid2"><div class="panel"><h2>各時段平均用餐時間</h2><div id="hourDining" class="chart barlist"></div></div><div class="panel"><h2>各門市折扣率</h2><div id="storeDisc" class="chart barlist"></div></div></div>
    <div class="diaggrid">
      <div class="diag problem"><div class="eyebrow">PROBLEM DETECTED</div><h3 id="problemTitle">—</h3><p id="problemText">—</p></div>
      <div class="diag"><div class="eyebrow">ROOT CAUSE</div><h3>往下切資料找原因</h3><div id="causes"></div></div>
      <div class="diag action"><div class="eyebrow">RECOMMENDED ACTION</div><h3>把洞察轉成改善</h3><div id="actions"></div></div>
    </div>
    <div class="panel story"><div class="step"><div class="circle">1</div><b>POS Data</b><small>交易 / 會員 / 商品 / 時間</small></div><div class="arrow">→</div><div class="step"><div class="circle">2</div><b>KPI</b><small>營收 / 客單 / 翻桌</small></div><div class="arrow">→</div><div class="step"><div class="circle">3</div><b>Insight</b><small>找出門市與時段異常</small></div><div class="arrow">→</div><div class="step"><div class="circle">4</div><b>Action</b><small>排班 / 備料 / 流程</small></div></div>
  </section>

  <div class="note">Demo 使用完全模擬之 POS 交易資料，不含任何真實會員或顧客個資。</div>
</main></div>

